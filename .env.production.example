# Configurações do Servidor
NODE_ENV=production
PORT=3001
API_URL=https://seu-dominio.com
FRONTEND_URL=https://seu-dominio.com

# JWT
JWT_SECRET=sua_chave_secreta_muito_segura_aqui
JWT_EXPIRES_IN=7d

# Banco de Dados (PostgreSQL)
DATABASE_URL=postgresql://usuario:senha@host:porta/database

# Google OAuth
GOOGLE_CLIENT_ID=seu_google_client_id
GOOGLE_CLIENT_SECRET=seu_google_client_secret
GOOGLE_CALLBACK_URL=https://seu-dominio.com/api/v1/auth/google/callback

# Gemini AI
GEMINI_API_KEY=sua_gemini_api_key

# Email (SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=seu_email@gmail.com
SMTP_PASS=sua_senha_de_app
EMAIL_FROM=no-reply@seu-dominio.com

# Mercado Pago
MERCADOPAGO_ACCESS_TOKEN=seu_access_token_mercado_pago
MERCADOPAGO_WEBHOOK_SECRET=sua_chave_secreta_webhook

# Deployment Configuration
RUN_MIGRATIONS=true
RUN_DEPLOYMENT_INIT=true
